# PostgreSQL connection string, get this from Railway once the database is provisioned
DATABASE_URL="postgresql://user:password@host:5432/lavish_cinemas"

# Paystack keys, from your Paystack dashboard (use test keys until you go live)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxx"

# The live URL of the site, used to build the Paystack callback link
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Password for the shared staff admin login at /admin
ADMIN_PASSWORD="change-this-to-something-only-staff-know"

# Google Sheets API key, read-only, used to check the shared Hall 1 / Hall 2
# calendar for walk-in/phone bookings when computing live availability.
# See README "Calendar sheet availability" for how to get this.
GOOGLE_SHEETS_API_KEY=""
